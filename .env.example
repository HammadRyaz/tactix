# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (must be 3000 in AI Studio)
PORT=3000

# MONGODB_URI: MongoDB connection string (falls back to embedded MongoDB Memory Server in dev if unset)
MONGODB_URI="mongodb://localhost:27017/tactix_arena"

# JWT_SECRET: Cryptographic secret for signing HTTP-only auth cookies
JWT_SECRET="replace-with-a-strong-random-64-char-secret"

# JWT_EXPIRES_IN: Token expiration duration
JWT_EXPIRES_IN="7d"

# CLIENT_ORIGIN: Allowed CORS origin (comma-separated for multiple)
CLIENT_ORIGIN="http://localhost:3000"

# NODE_ENV: development | production
NODE_ENV="development"
